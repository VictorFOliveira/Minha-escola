# Copie para .env.production e nunca versione o arquivo preenchido.
APP_DOMAIN="escola.seudominio.com"
ACME_EMAIL="infra@seudominio.com"
APP_URL="https://escola.seudominio.com"
APP_VERSION="1.0.0"

# Banco gerenciado recomendado. Para PostgreSQL no mesmo VPS, use:
# COMPOSE_PROFILES="local-db"
# DATABASE_URL="postgresql://minha_escola:SENHA_FORTE@db:5432/minha_escola?schema=public"
DATABASE_URL="postgresql://usuario:senha@host-gerenciado:5432/minha_escola?schema=public&sslmode=require"
POSTGRES_USER="minha_escola"
POSTGRES_PASSWORD=""
POSTGRES_DB="minha_escola"

# Secrets independentes, 32+ caracteres.
AUTH_SECRET=""
PLATFORM_AUTH_SECRET=""
SECURITY_PEPPER=""
CRON_SECRET=""
MFA_ENCRYPTION_KEY=""

# Storage privado.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"

# Uploads: fail-closed em production.
REQUIRE_MALWARE_SCAN="true"
MALWARE_SCAN_PROVIDER="external"
MALWARE_SCAN_WEBHOOK_URL=""
MALWARE_SCAN_CALLBACK_TOKEN=""

# E-mail.
RESEND_API_KEY=""
EMAIL_FROM="Minha Escola <nao-responda@seudominio.com>"

# WhatsApp opcional.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"

# Asaas da escola, opcional.
ASAAS_ENVIRONMENT="production"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Asaas da plataforma, separado.
PLATFORM_ASAAS_ENVIRONMENT="production"
PLATFORM_ASAAS_API_KEY=""
PLATFORM_ASAAS_WEBHOOK_TOKEN=""
PLATFORM_BILLING_GRACE_DAYS="7"

# Observabilidade.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.05"

# Backup.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"
