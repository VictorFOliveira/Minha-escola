generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDINATOR
  SECRETARY
  TEACHER
  FINANCE
  STUDENT
  GUARDIAN
}

enum EnrollmentStatus {
  ACTIVE
  PENDING
  TRANSFERRED
  CANCELLED
}

enum EnrollmentType {
  NEW
  REENROLLMENT
  TRANSFER
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum AssessmentType {
  EXAM
  QUIZ
  ASSIGNMENT
  PROJECT
  PARTICIPATION
  OTHER
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FeedbackCategory {
  FORMATIVE
  ACADEMIC
  BEHAVIOR
  SUPPORT
  GENERAL
}

enum FeedbackVisibility {
  INTERNAL
  STUDENT
  GUARDIAN
  BOTH
}

enum LessonStatus {
  PLANNED
  OPEN
  COMPLETED
  CANCELLED
}

enum LessonAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RecoveryCalculationMode {
  REPLACE_IF_HIGHER
  AVERAGE_WITH_ANNUAL
  MANUAL
}

enum PeriodGradeStatus {
  OPEN
  CLOSED
}

enum SubjectResultStatus {
  IN_PROGRESS
  APPROVED
  RECOVERY
  FAILED_GRADE
  FAILED_ATTENDANCE
}

enum EnrollmentResultStatus {
  IN_PROGRESS
  APPROVED
  FAILED
}

model School {
  id        String       @id @default(cuid())
  name      String
  document  String?      @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  users     User[]
  students  Student[]
  guardians Guardian[]
  teachers  Teacher[]
  employees Employee[]
  classes   ClassGroup[]
  subjects  Subject[]
  curricula Curriculum[]
  academicPeriods AcademicPeriod[]
  academicPolicies AcademicPolicy[]
  feedbacks AcademicFeedback[]
  charges   Charge[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model User {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  email       String   @unique
  password    String
  role        UserRole
  active      Boolean  @default(true)
  lastLoginAt DateTime?
  enrollmentId String? @unique
  enrollment   Enrollment? @relation("StudentPortalUser", fields: [enrollmentId], references: [id], onDelete: SetNull)
  guardianId  String?  @unique
  guardian    Guardian? @relation("GuardianPortalUser", fields: [guardianId], references: [id], onDelete: SetNull)
  teacherId   String?  @unique
  teacher     Teacher? @relation("TeacherPortalUser", fields: [teacherId], references: [id], onDelete: SetNull)
  resetTokens PasswordResetToken[]
  feedbacksAuthored AcademicFeedback[]
  lessonsCreated Lesson[]
  attendanceRecords LessonAttendance[]
  periodGradesClosed PeriodGrade[] @relation("PeriodGradeClosedBy")
  subjectResultsClosed SubjectFinalResult[] @relation("SubjectResultClosedBy")
  enrollmentResultsClosed EnrollmentAcademicResult[] @relation("EnrollmentResultClosedBy")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, role, active])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Student {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  registration String
  name         String
  birthDate    DateTime?
  document     String?
  phone        String?
  email        String?
  address      String?
  status       PersonStatus @default(ACTIVE)
  guardians    StudentGuardian[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  grades       Grade[]
  charges      Charge[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schoolId, registration])
  @@index([schoolId, name])
  @@index([schoolId, status])
}

model Guardian {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  phone     String
  email     String?
  address   String?
  status    PersonStatus @default(ACTIVE)
  students  StudentGuardian[]
  portalUser User?        @relation("GuardianPortalUser")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model StudentGuardian {
  studentId    String
  guardianId   String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship String
  financialResponsible Boolean @default(false)
  authorizedPickup     Boolean @default(true)
  createdAt             DateTime @default(now())

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Teacher {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  email     String?
  phone     String?
  specialty String?
  status    PersonStatus @default(ACTIVE)
  classes   ClassGroup[]
  classSubjects ClassSubject[]
  portalUser User?        @relation("TeacherPortalUser")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model Employee {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  document   String?
  email      String?
  phone      String?
  jobTitle   String
  department String?
  status     PersonStatus @default(ACTIVE)
  hiredAt    DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model ClassGroup {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  curriculumId String?
  curriculum   Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  name         String
  gradeLevel   String
  shift        String
  room         String?
  capacity     Int?
  schoolYear   Int
  classSubjects ClassSubject[]
  periodGrades PeriodGrade[]
  subjectResults SubjectFinalResult[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  grades       Grade[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([schoolId, schoolYear])
  @@index([curriculumId])
}

model Subject {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  active      Boolean      @default(true)
  curriculumSubjects CurriculumSubject[]
  classSubjects ClassSubject[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, active])
}

model Curriculum {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  gradeLevel  String
  schoolYear  Int
  active      Boolean      @default(true)
  subjects    CurriculumSubject[]
  classes     ClassGroup[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([schoolId, gradeLevel, schoolYear])
  @@index([schoolId, schoolYear, active])
}

model CurriculumSubject {
  id             String     @id @default(cuid())
  curriculumId   String
  curriculum     Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  weeklyClasses  Int?
  workloadHours  Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([curriculumId, subjectId])
  @@index([subjectId])
}

model ClassSubject {
  id            String     @id @default(cuid())
  classId       String
  class         ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId     String?
  teacher       Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  weeklyClasses Int?
  scheduleSlots ClassScheduleSlot[]
  assessments Assessment[]
  lessons     Lesson[]
  periodGrades PeriodGrade[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([teacherId])
}

model ClassScheduleSlot {
  id             String       @id @default(cuid())
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String
  endTime        String
  room           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([classSubjectId, weekday])
}

model AcademicPeriod {
  id         String               @id @default(cuid())
  schoolId   String
  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear Int
  name       String
  order      Int
  startDate  DateTime
  endDate    DateTime
  status     AcademicPeriodStatus @default(PLANNED)
  assessments Assessment[]
  lessons     Lesson[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([schoolId, schoolYear, order])
  @@index([schoolId, schoolYear, status])
}

model Enrollment {
  id                   String           @id @default(cuid())
  studentId            String
  student              Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId              String
  class                ClassGroup       @relation(fields: [classId], references: [id], onDelete: Cascade)
  type                 EnrollmentType   @default(NEW)
  status               EnrollmentStatus @default(ACTIVE)
  startedAt            DateTime         @default(now())
  endedAt              DateTime?
  notes                String?
  previousEnrollmentId String?          @unique
  previousEnrollment   Enrollment?      @relation("EnrollmentHistory", fields: [previousEnrollmentId], references: [id], onDelete: SetNull)
  nextEnrollment       Enrollment?      @relation("EnrollmentHistory")
  portalUser           User?             @relation("StudentPortalUser")
  assessmentScores     AssessmentScore[]
  feedbacks            AcademicFeedback[]
  lessonAttendances    LessonAttendance[]
  periodGrades         PeriodGrade[]
  subjectResults       SubjectFinalResult[]
  academicResult       EnrollmentAcademicResult?

  @@unique([studentId, classId])
  @@index([classId, status])
  @@index([studentId, status])
}

model Assessment {
  id             String           @id @default(cuid())
  classSubjectId String
  classSubject   ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  periodId       String
  period         AcademicPeriod   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  type           AssessmentType   @default(EXAM)
  status         AssessmentStatus @default(DRAFT)
  assessmentDate DateTime
  dueDate        DateTime?
  maxScore       Decimal          @default(10) @db.Decimal(6, 2)
  weight         Decimal          @default(1) @db.Decimal(6, 2)
  scores         AssessmentScore[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([classSubjectId, periodId, status])
}

model AssessmentScore {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  score        Decimal?   @db.Decimal(6, 2)
  absent       Boolean    @default(false)
  excused      Boolean    @default(false)
  feedback     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId])
}

model AcademicFeedback {
  id           String             @id @default(cuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User               @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  category     FeedbackCategory   @default(FORMATIVE)
  visibility   FeedbackVisibility @default(BOTH)
  title        String
  content      String
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([schoolId, enrollmentId, visibility])
  @@index([authorUserId])
}

model Lesson {
  id               String       @id @default(cuid())
  classSubjectId   String
  classSubject     ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  periodId         String?
  period           AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdByUserId  String
  createdBy        User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lessonDate       DateTime
  startTime        String?
  endTime          String?
  plannedContent   String?
  taughtContent    String?
  homework         String?
  notes            String?
  status           LessonStatus @default(PLANNED)
  attendance       LessonAttendance[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([classSubjectId, lessonDate, status])
  @@index([periodId])
  @@index([createdByUserId])
}

model LessonAttendance {
  id           String                 @id @default(cuid())
  lessonId     String
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedByUserId String
  recordedBy   User                   @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  status       LessonAttendanceStatus @default(PRESENT)
  note         String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([lessonId, enrollmentId])
  @@index([enrollmentId])
  @@index([recordedByUserId])
}

model AcademicPolicy {
  id                     String                  @id @default(cuid())
  schoolId               String
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear             Int
  passingAverage         Decimal                 @default(6) @db.Decimal(5, 2)
  minimumAttendance      Decimal                 @default(75) @db.Decimal(5, 2)
  recoveryEnabled        Boolean                 @default(true)
  recoveryMode           RecoveryCalculationMode @default(REPLACE_IF_HIGHER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([schoolId, schoolYear])
  @@index([schoolId, schoolYear])
}

model PeriodGrade {
  id             String            @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject      @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  periodId       String
  period         AcademicPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  average        Decimal?          @db.Decimal(5, 2)
  status         PeriodGradeStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?             @relation("PeriodGradeClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([enrollmentId, classSubjectId, periodId])
  @@index([classSubjectId, periodId, status])
  @@index([closedByUserId])
}

model SubjectFinalResult {
  id                String              @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classSubjectId    String
  classSubject      ClassSubject        @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  annualAverage     Decimal?            @db.Decimal(5, 2)
  recoveryScore     Decimal?            @db.Decimal(5, 2)
  finalAverage      Decimal?            @db.Decimal(5, 2)
  attendancePercent Decimal?            @db.Decimal(5, 2)
  status            SubjectResultStatus @default(IN_PROGRESS)
  closedAt          DateTime?
  closedByUserId    String?
  closedBy          User?               @relation("SubjectResultClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([enrollmentId, classSubjectId])
  @@index([classSubjectId, status])
  @@index([closedByUserId])
}

model EnrollmentAcademicResult {
  id             String                 @id @default(cuid())
  enrollmentId   String                 @unique
  enrollment     Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status         EnrollmentResultStatus @default(IN_PROGRESS)
  decisionNote   String?
  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?                  @relation("EnrollmentResultClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status])
  @@index([closedByUserId])
}

model Attendance {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean
  note      String?
  createdAt DateTime   @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
}

model Grade {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String
  term      String
  value     Decimal    @db.Decimal(5, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([studentId, classId])
}

model Charge {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal      @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      ChargeStatus @default(PENDING)
  externalId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([schoolId, status, dueDate])
}
