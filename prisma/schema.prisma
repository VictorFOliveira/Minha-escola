generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SECRETARY
  TEACHER
  FINANCE
  GUARDIAN
}

enum EnrollmentStatus {
  ACTIVE
  PENDING
  TRANSFERRED
  CANCELLED
}

enum EnrollmentType {
  NEW
  REENROLLMENT
  TRANSFER
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

model School {
  id        String       @id @default(cuid())
  name      String
  document  String?      @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  users     User[]
  students  Student[]
  guardians Guardian[]
  teachers  Teacher[]
  employees Employee[]
  classes   ClassGroup[]
  charges   Charge[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model User {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  email       String   @unique
  password    String
  role        UserRole
  active      Boolean  @default(true)
  lastLoginAt DateTime?
  resetTokens PasswordResetToken[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, role, active])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Student {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  registration String
  name         String
  birthDate    DateTime?
  document     String?
  phone        String?
  email        String?
  address      String?
  status       PersonStatus @default(ACTIVE)
  guardians    StudentGuardian[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  grades       Grade[]
  charges      Charge[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schoolId, registration])
  @@index([schoolId, name])
  @@index([schoolId, status])
}

model Guardian {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  phone     String
  email     String?
  address   String?
  status    PersonStatus @default(ACTIVE)
  students  StudentGuardian[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model StudentGuardian {
  studentId    String
  guardianId   String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship String
  financialResponsible Boolean @default(false)
  authorizedPickup     Boolean @default(true)
  createdAt             DateTime @default(now())

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Teacher {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  email     String?
  phone     String?
  specialty String?
  status    PersonStatus @default(ACTIVE)
  classes   ClassGroup[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model Employee {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  document   String?
  email      String?
  phone      String?
  jobTitle   String
  department String?
  status     PersonStatus @default(ACTIVE)
  hiredAt    DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model ClassGroup {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  name        String
  gradeLevel  String
  shift       String
  room        String?
  capacity    Int?
  schoolYear  Int
  enrollments Enrollment[]
  attendances Attendance[]
  grades      Grade[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([schoolId, schoolYear])
}

model Enrollment {
  id                   String           @id @default(cuid())
  studentId            String
  student              Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId              String
  class                ClassGroup       @relation(fields: [classId], references: [id], onDelete: Cascade)
  type                 EnrollmentType   @default(NEW)
  status               EnrollmentStatus @default(ACTIVE)
  startedAt            DateTime         @default(now())
  endedAt              DateTime?
  notes                String?
  previousEnrollmentId String?          @unique
  previousEnrollment   Enrollment?      @relation("EnrollmentHistory", fields: [previousEnrollmentId], references: [id], onDelete: SetNull)
  nextEnrollment       Enrollment?      @relation("EnrollmentHistory")

  @@unique([studentId, classId])
  @@index([classId, status])
  @@index([studentId, status])
}

model Attendance {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean
  note      String?
  createdAt DateTime   @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
}

model Grade {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String
  term      String
  value     Decimal    @db.Decimal(5, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([studentId, classId])
}

model Charge {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal      @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      ChargeStatus @default(PENDING)
  externalId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([schoolId, status, dueDate])
}
