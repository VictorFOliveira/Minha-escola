generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDINATOR
  SECRETARY
  TEACHER
  FINANCE
  STUDENT
  GUARDIAN
}

enum EnrollmentStatus {
  ACTIVE
  PENDING
  TRANSFERRED
  CANCELLED
}

enum EnrollmentType {
  NEW
  REENROLLMENT
  TRANSFER
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum BillingContractStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  CANCELLED
}

enum BillingBenefitType {
  SCHOLARSHIP
  DISCOUNT
}

enum BillingValueType {
  PERCENTAGE
  FIXED
}

enum PaymentProvider {
  MANUAL
  ASAAS
  EXTERNAL
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
  CASH
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  CONFIRMED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum AssessmentType {
  EXAM
  QUIZ
  ASSIGNMENT
  PROJECT
  PARTICIPATION
  OTHER
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FeedbackCategory {
  FORMATIVE
  ACADEMIC
  BEHAVIOR
  SUPPORT
  GENERAL
}

enum FeedbackVisibility {
  INTERNAL
  STUDENT
  GUARDIAN
  BOTH
}

enum LessonStatus {
  PLANNED
  OPEN
  COMPLETED
  CANCELLED
}

enum LessonAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RecoveryCalculationMode {
  REPLACE_IF_HIGHER
  AVERAGE_WITH_ANNUAL
  MANUAL
}

enum PeriodGradeStatus {
  OPEN
  CLOSED
}

enum SubjectResultStatus {
  IN_PROGRESS
  APPROVED
  RECOVERY
  FAILED_GRADE
  FAILED_ATTENDANCE
}

enum EnrollmentResultStatus {
  IN_PROGRESS
  APPROVED
  FAILED
}

enum CommunicationAudience {
  SCHOOL
  STAFF
  STUDENTS
  GUARDIANS
  FINANCIAL_GUARDIANS
  CLASS_STUDENTS
  CLASS_GUARDIANS
  CLASS_BOTH
  INDIVIDUAL_STUDENT
  INDIVIDUAL_GUARDIAN
}

enum CommunicationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum CommunicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeliveryChannel {
  PORTAL
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AuthorizationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum SchoolDocumentType {
  ENROLLMENT_DECLARATION
  ATTENDANCE_DECLARATION
  REPORT_CARD
  SCHOOL_RECORD
  PAYMENT_RECEIPT
  ENROLLMENT_CONTRACT
  CUSTOM
}

enum SchoolDocumentStatus {
  ISSUED
  CANCELLED
}

enum SchoolLifecycleStatus {
  ONBOARDING
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
}

enum FileAssetStatus {
  PENDING
  READY
  DELETED
}

enum PrivacyRequestType {
  ACCESS_EXPORT
  CORRECTION
  ANONYMIZATION
  DELETION
}

enum PrivacyRequestStatus {
  OPEN
  IN_REVIEW
  COMPLETED
  REJECTED
}

enum PrivacySubjectType {
  STUDENT
  GUARDIAN
  USER
}

enum ConsentKind {
  PRIVACY_POLICY
  TERMS_OF_USE
  COMMUNICATION
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model School {
  id        String       @id @default(cuid())
  name      String
  slug      String?      @unique
  lifecycleStatus SchoolLifecycleStatus @default(ACTIVE)
  onboardingCompletedAt DateTime?
  document  String?      @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  users     User[]
  students  Student[]
  guardians Guardian[]
  teachers  Teacher[]
  employees Employee[]
  classes   ClassGroup[]
  subjects  Subject[]
  curricula Curriculum[]
  academicPeriods AcademicPeriod[]
  academicPolicies AcademicPolicy[]
  feedbacks AcademicFeedback[]
  billingPlans BillingPlan[]
  billingContracts BillingContract[]
  paymentCustomers PaymentCustomer[]
  financeSettings FinanceSettings?
  communicationSettings CommunicationSettings?
  communications Communication[]
  communicationAttachments CommunicationAttachment[]
  documentTemplates DocumentTemplate[]
  schoolDocuments SchoolDocument[]
  subscription SchoolSubscription?
  auditLogs AuditLog[]
  fileAssets FileAsset[]
  privacySettings PrivacySettings?
  privacyRequests DataPrivacyRequest[]
  charges   Charge[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model User {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  email       String   @unique
  password    String
  role        UserRole
  active      Boolean  @default(true)
  lastLoginAt DateTime?
  enrollmentId String? @unique
  enrollment   Enrollment? @relation("StudentPortalUser", fields: [enrollmentId], references: [id], onDelete: SetNull)
  guardianId  String?  @unique
  guardian    Guardian? @relation("GuardianPortalUser", fields: [guardianId], references: [id], onDelete: SetNull)
  teacherId   String?  @unique
  teacher     Teacher? @relation("TeacherPortalUser", fields: [teacherId], references: [id], onDelete: SetNull)
  resetTokens PasswordResetToken[]
  feedbacksAuthored AcademicFeedback[]
  lessonsCreated Lesson[]
  attendanceRecords LessonAttendance[]
  periodGradesClosed PeriodGrade[] @relation("PeriodGradeClosedBy")
  subjectResultsClosed SubjectFinalResult[] @relation("SubjectResultClosedBy")
  enrollmentResultsClosed EnrollmentAcademicResult[] @relation("EnrollmentResultClosedBy")
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")
  communicationsAuthored Communication[] @relation("CommunicationAuthor")
  communicationRecipients CommunicationRecipient[]
  documentsIssued SchoolDocument[] @relation("DocumentIssuedBy")
  auditLogs AuditLog[]
  filesCreated FileAsset[]
  privacyRequests DataPrivacyRequest[] @relation("PrivacyRequestedBy")
  privacyRequestsProcessed DataPrivacyRequest[] @relation("PrivacyProcessedBy")
  consents ConsentRecord[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, role, active])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Student {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  registration String
  name         String
  birthDate    DateTime?
  document     String?
  phone        String?
  email        String?
  address      String?
  status       PersonStatus @default(ACTIVE)
  guardians    StudentGuardian[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  grades       Grade[]
  charges      Charge[]
  authorizationRequests AuthorizationRequest[]
  schoolDocuments SchoolDocument[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schoolId, registration])
  @@index([schoolId, name])
  @@index([schoolId, status])
}

model Guardian {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  phone     String
  email     String?
  address   String?
  status    PersonStatus @default(ACTIVE)
  students  StudentGuardian[]
  billingContracts BillingContract[]
  paymentCustomers PaymentCustomer[]
  charges Charge[]
  communicationRecipients CommunicationRecipient[]
  authorizationRequests AuthorizationRequest[]
  schoolDocuments SchoolDocument[]
  portalUser User?        @relation("GuardianPortalUser")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model StudentGuardian {
  studentId    String
  guardianId   String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship String
  financialResponsible Boolean @default(false)
  authorizedPickup     Boolean @default(true)
  createdAt             DateTime @default(now())

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Teacher {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  email     String?
  phone     String?
  specialty String?
  status    PersonStatus @default(ACTIVE)
  classes   ClassGroup[]
  classSubjects ClassSubject[]
  portalUser User?        @relation("TeacherPortalUser")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model Employee {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  document   String?
  email      String?
  phone      String?
  jobTitle   String
  department String?
  status     PersonStatus @default(ACTIVE)
  hiredAt    DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([schoolId, name])
  @@index([schoolId, status])
}

model ClassGroup {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  curriculumId String?
  curriculum   Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  name         String
  gradeLevel   String
  shift        String
  room         String?
  capacity     Int?
  schoolYear   Int
  classSubjects ClassSubject[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  grades       Grade[]
  targetedCommunications Communication[] @relation("TargetClass")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([schoolId, schoolYear])
  @@index([curriculumId])
}

model Subject {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  active      Boolean      @default(true)
  curriculumSubjects CurriculumSubject[]
  classSubjects ClassSubject[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, active])
}

model Curriculum {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  gradeLevel  String
  schoolYear  Int
  active      Boolean      @default(true)
  subjects    CurriculumSubject[]
  classes     ClassGroup[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([schoolId, gradeLevel, schoolYear])
  @@index([schoolId, schoolYear, active])
}

model CurriculumSubject {
  id             String     @id @default(cuid())
  curriculumId   String
  curriculum     Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  weeklyClasses  Int?
  workloadHours  Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([curriculumId, subjectId])
  @@index([subjectId])
}

model ClassSubject {
  id            String     @id @default(cuid())
  classId       String
  class         ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId     String?
  teacher       Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  weeklyClasses Int?
  scheduleSlots ClassScheduleSlot[]
  assessments Assessment[]
  lessons     Lesson[]
  periodGrades PeriodGrade[]
  subjectResults SubjectFinalResult[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([teacherId])
}

model ClassScheduleSlot {
  id             String       @id @default(cuid())
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String
  endTime        String
  room           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([classSubjectId, weekday])
}

model AcademicPeriod {
  id         String               @id @default(cuid())
  schoolId   String
  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear Int
  name       String
  order      Int
  startDate  DateTime
  endDate    DateTime
  weight     Decimal              @default(1) @db.Decimal(6, 2)
  status     AcademicPeriodStatus @default(PLANNED)
  assessments Assessment[]
  lessons     Lesson[]
  periodGrades PeriodGrade[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([schoolId, schoolYear, order])
  @@index([schoolId, schoolYear, status])
}

model Enrollment {
  id                   String           @id @default(cuid())
  studentId            String
  student              Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId              String
  class                ClassGroup       @relation(fields: [classId], references: [id], onDelete: Cascade)
  type                 EnrollmentType   @default(NEW)
  status               EnrollmentStatus @default(ACTIVE)
  startedAt            DateTime         @default(now())
  endedAt              DateTime?
  notes                String?
  previousEnrollmentId String?          @unique
  previousEnrollment   Enrollment?      @relation("EnrollmentHistory", fields: [previousEnrollmentId], references: [id], onDelete: SetNull)
  nextEnrollment       Enrollment?      @relation("EnrollmentHistory")
  portalUser           User?             @relation("StudentPortalUser")
  assessmentScores     AssessmentScore[]
  feedbacks            AcademicFeedback[]
  lessonAttendances    LessonAttendance[]
  periodGrades         PeriodGrade[]
  subjectResults       SubjectFinalResult[]
  academicResult       EnrollmentAcademicResult?
  billingContract      BillingContract?
  charges              Charge[]
  communicationRecipients CommunicationRecipient[]
  targetedCommunications Communication[] @relation("TargetEnrollment")
  schoolDocuments SchoolDocument[]

  @@unique([studentId, classId])
  @@index([classId, status])
  @@index([studentId, status])
}

model Assessment {
  id             String           @id @default(cuid())
  classSubjectId String
  classSubject   ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  periodId       String
  period         AcademicPeriod   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  type           AssessmentType   @default(EXAM)
  status         AssessmentStatus @default(DRAFT)
  assessmentDate DateTime
  dueDate        DateTime?
  maxScore       Decimal          @default(10) @db.Decimal(6, 2)
  weight         Decimal          @default(1) @db.Decimal(6, 2)
  scores         AssessmentScore[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([classSubjectId, periodId, status])
}

model AssessmentScore {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  score        Decimal?   @db.Decimal(6, 2)
  absent       Boolean    @default(false)
  excused      Boolean    @default(false)
  feedback     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId])
}

model AcademicFeedback {
  id           String             @id @default(cuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User               @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  category     FeedbackCategory   @default(FORMATIVE)
  visibility   FeedbackVisibility @default(BOTH)
  title        String
  content      String
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([schoolId, enrollmentId, visibility])
  @@index([authorUserId])
}

model Lesson {
  id               String       @id @default(cuid())
  classSubjectId   String
  classSubject     ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  periodId         String?
  period           AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdByUserId  String
  createdBy        User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lessonDate       DateTime
  startTime        String?
  endTime          String?
  plannedContent   String?
  taughtContent    String?
  homework         String?
  notes            String?
  status           LessonStatus @default(PLANNED)
  attendance       LessonAttendance[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([classSubjectId, lessonDate, status])
  @@index([periodId])
  @@index([createdByUserId])
}

model LessonAttendance {
  id           String                 @id @default(cuid())
  lessonId     String
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedByUserId String
  recordedBy   User                   @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  status       LessonAttendanceStatus @default(PRESENT)
  note         String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([lessonId, enrollmentId])
  @@index([enrollmentId])
  @@index([recordedByUserId])
}

model AcademicPolicy {
  id                     String                  @id @default(cuid())
  schoolId               String
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear             Int
  passingAverage         Decimal                 @default(6) @db.Decimal(5, 2)
  minimumAttendance      Decimal                 @default(75) @db.Decimal(5, 2)
  recoveryEnabled        Boolean                 @default(true)
  recoveryMode           RecoveryCalculationMode @default(REPLACE_IF_HIGHER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([schoolId, schoolYear])
  @@index([schoolId, schoolYear])
}

model PeriodGrade {
  id             String            @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject      @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  periodId       String
  period         AcademicPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  average        Decimal?          @db.Decimal(5, 2)
  status         PeriodGradeStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?             @relation("PeriodGradeClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([enrollmentId, classSubjectId, periodId])
  @@index([classSubjectId, periodId, status])
  @@index([closedByUserId])
}

model SubjectFinalResult {
  id                String              @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classSubjectId    String
  classSubject      ClassSubject        @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  annualAverage     Decimal?            @db.Decimal(5, 2)
  recoveryScore     Decimal?            @db.Decimal(5, 2)
  finalAverage      Decimal?            @db.Decimal(5, 2)
  attendancePercent Decimal?            @db.Decimal(5, 2)
  status            SubjectResultStatus @default(IN_PROGRESS)
  closedAt          DateTime?
  closedByUserId    String?
  closedBy          User?               @relation("SubjectResultClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([enrollmentId, classSubjectId])
  @@index([classSubjectId, status])
  @@index([closedByUserId])
}

model EnrollmentAcademicResult {
  id             String                 @id @default(cuid())
  enrollmentId   String                 @unique
  enrollment     Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status         EnrollmentResultStatus @default(IN_PROGRESS)
  decisionNote   String?
  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?                  @relation("EnrollmentResultClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status])
  @@index([closedByUserId])
}

model Attendance {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean
  note      String?
  createdAt DateTime   @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
}

model Grade {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String
  term      String
  value     Decimal    @db.Decimal(5, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([studentId, classId])
}

model FinanceSettings {
  id                    String          @id @default(cuid())
  schoolId              String          @unique
  school                 School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  provider               PaymentProvider @default(MANUAL)
  gatewayEnabled         Boolean         @default(false)
  externalPaymentUrl     String?
  sendBillingToGuardian  Boolean         @default(true)
  sendReportToGuardian   Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}


model CommunicationSettings {
  id               String @id @default(cuid())
  schoolId         String @unique
  school           School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  portalEnabled    Boolean @default(true)
  emailEnabled     Boolean @default(false)
  whatsappEnabled  Boolean @default(false)
  emailProvider    String?
  whatsappProvider String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Communication {
  id                    String                @id @default(cuid())
  schoolId              String
  school                School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorUserId          String
  author                User                  @relation("CommunicationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  systemKey             String?
  title                 String
  content               String
  priority              CommunicationPriority @default(NORMAL)
  status                CommunicationStatus   @default(DRAFT)
  audience              CommunicationAudience
  targetClassId         String?
  targetClass           ClassGroup?           @relation("TargetClass", fields: [targetClassId], references: [id], onDelete: SetNull)
  targetEnrollmentId    String?
  targetEnrollment      Enrollment?           @relation("TargetEnrollment", fields: [targetEnrollmentId], references: [id], onDelete: SetNull)
  targetGuardianId      String?
  requiresAcknowledgement Boolean             @default(false)
  requiresAuthorization Boolean               @default(false)
  publishAt             DateTime?
  expiresAt             DateTime?
  recipients            CommunicationRecipient[]
  attachments           CommunicationAttachment[]
  authorizationRequests AuthorizationRequest[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([schoolId, systemKey])
  @@index([schoolId, status, publishAt])
  @@index([targetClassId])
  @@index([targetEnrollmentId])
  @@index([targetGuardianId])
}

model CommunicationRecipient {
  id               String        @id @default(cuid())
  communicationId  String
  communication    Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  recipientKey     String
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianId       String?
  guardian         Guardian?     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  enrollmentId     String?
  enrollment       Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  readAt           DateTime?
  acknowledgedAt   DateTime?
  deliveries       CommunicationDelivery[]
  createdAt        DateTime      @default(now())

  @@unique([communicationId, recipientKey])
  @@index([userId, readAt])
  @@index([guardianId, readAt])
  @@index([enrollmentId, readAt])
}

model CommunicationAttachment {
  id              String        @id @default(cuid())
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  fileAssetId     String?
  fileAsset       FileAsset?    @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  name            String
  url             String?
  mimeType        String?
  createdAt       DateTime      @default(now())

  @@index([schoolId, communicationId])
  @@index([fileAssetId])
}

model CommunicationDelivery {
  id          String                 @id @default(cuid())
  recipientId String
  recipient   CommunicationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  channel     DeliveryChannel
  status      DeliveryStatus         @default(PENDING)
  destination String?
  providerId  String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([recipientId, channel])
  @@index([channel, status])
}

model AuthorizationRequest {
  id              String              @id @default(cuid())
  communicationId String
  communication   Communication       @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId      String
  guardian        Guardian            @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  status          AuthorizationStatus @default(PENDING)
  responseNote    String?
  respondedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([communicationId, studentId, guardianId])
  @@index([guardianId, status])
  @@index([studentId, status])
}


model DocumentTemplate {
  id          String             @id @default(cuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type        SchoolDocumentType
  name        String
  bodyTemplate String
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([schoolId, type, name])
  @@index([schoolId, type, active])
}

model SchoolDocument {
  id                 String               @id @default(cuid())
  schoolId           String
  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type               SchoolDocumentType
  status             SchoolDocumentStatus @default(ISSUED)
  title              String
  studentId          String?
  student            Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  enrollmentId       String?
  enrollment         Enrollment?          @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  guardianId         String?
  guardian           Guardian?            @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  chargeId           String?
  charge             Charge?              @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  issuedByUserId     String
  issuedBy           User                 @relation("DocumentIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  verificationCode   String               @unique
  snapshot           Json
  renderedHtml       String
  issuedAt           DateTime             @default(now())
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime             @default(now())

  @@index([schoolId, type, issuedAt])
  @@index([studentId, issuedAt])
  @@index([enrollmentId, issuedAt])
  @@index([guardianId, issuedAt])
  @@index([chargeId])
  @@index([issuedByUserId])
}


model PlatformAdmin {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  password    String
  active      Boolean    @default(true)
  lastLoginAt DateTime?
  auditLogs   AuditLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SaaSPlan {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  monthlyPrice  Decimal  @db.Decimal(12, 2)
  annualPrice   Decimal? @db.Decimal(12, 2)
  maxStudents   Int?
  maxUsers      Int?
  features      Json?
  active        Boolean  @default(true)
  subscriptions SchoolSubscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SchoolSubscription {
  id                String             @id @default(cuid())
  schoolId          String             @unique
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId            String
  plan              SaaSPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  status            SubscriptionStatus @default(TRIAL)
  provider          PaymentProvider    @default(MANUAL)
  externalId        String?
  startedAt         DateTime           @default(now())
  trialEndsAt       DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  nextBillingAt     DateTime?
  externalCustomerId String?
  invoices          PlatformInvoice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([provider, externalId])
  @@index([planId, status])
}

model AuditLog {
  id              String         @id @default(cuid())
  schoolId        String?
  school          School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  actorType       AuditActorType
  action          String
  entityType      String
  entityId        String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([platformAdminId, createdAt])
  @@index([entityType, entityId])
}


model FileAsset {
  id              String          @id @default(cuid())
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  objectKey       String          @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  status          FileAssetStatus @default(PENDING)
  sha256          String?
  attachments     CommunicationAttachment[]
  createdAt       DateTime        @default(now())
  readyAt         DateTime?
  deletedAt       DateTime?

  @@index([schoolId, status, createdAt])
  @@index([createdByUserId])
}

model PrivacySettings {
  id                      String   @id @default(cuid())
  schoolId                String   @unique
  school                  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicRetentionYears  Int      @default(10)
  financialRetentionYears Int      @default(5)
  auditRetentionDays      Int      @default(730)
  allowPortalRequests     Boolean  @default(true)
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
}

model DataPrivacyRequest {
  id                String               @id @default(cuid())
  schoolId          String
  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedBy       User?                @relation("PrivacyRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  processedByUserId String?
  processedBy       User?                @relation("PrivacyProcessedBy", fields: [processedByUserId], references: [id], onDelete: SetNull)
  type              PrivacyRequestType
  status            PrivacyRequestStatus @default(OPEN)
  subjectType       PrivacySubjectType
  subjectId         String
  reason            String?
  resolution        String?
  createdAt         DateTime             @default(now())
  processedAt       DateTime?

  @@index([schoolId, status, createdAt])
  @@index([subjectType, subjectId])
  @@index([requestedByUserId])
}

model ConsentRecord {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ConsentKind
  version    String
  acceptedAt DateTime    @default(now())
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@unique([userId, kind, version])
  @@index([userId, kind, revokedAt])
}

model PlatformInvoice {
  id             String                @id @default(cuid())
  subscriptionId String
  subscription   SchoolSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  provider       PaymentProvider       @default(ASAAS)
  externalId     String?
  amount         Decimal               @db.Decimal(12, 2)
  dueDate        DateTime
  status         PlatformInvoiceStatus @default(PENDING)
  invoiceUrl     String?
  paidAt         DateTime?
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([provider, externalId])
  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
}

model PlatformWebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType, createdAt])
}

model BillingPlan {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  schoolYear        Int
  installmentAmount Decimal  @db.Decimal(12, 2)
  installments      Int      @default(12)
  dueDay            Int
  active            Boolean  @default(true)
  contracts         BillingContract[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([schoolId, schoolYear, name])
  @@index([schoolId, schoolYear, active])
}

model BillingContract {
  id                String                @id @default(cuid())
  schoolId          String
  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollmentId      String                @unique
  enrollment        Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  guardianId        String?
  guardian          Guardian?             @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  billingPlanId     String?
  billingPlan       BillingPlan?          @relation(fields: [billingPlanId], references: [id], onDelete: SetNull)
  installmentAmount Decimal               @db.Decimal(12, 2)
  installments      Int                   @default(12)
  dueDay            Int
  firstDueDate      DateTime
  status            BillingContractStatus @default(ACTIVE)
  benefits          BillingBenefit[]
  charges           Charge[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([schoolId, status])
  @@index([guardianId])
  @@index([billingPlanId])
}

model BillingBenefit {
  id          String             @id @default(cuid())
  contractId  String
  contract    BillingContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name        String
  type        BillingBenefitType @default(DISCOUNT)
  valueType   BillingValueType
  value       Decimal            @db.Decimal(12, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([contractId, active])
}

model PaymentCustomer {
  id         String          @id @default(cuid())
  schoolId   String
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian        @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  provider   PaymentProvider
  externalId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([guardianId, provider])
  @@unique([provider, externalId])
  @@index([schoolId, provider])
}

model Charge {
  id              String          @id @default(cuid())
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId    String?
  enrollment      Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  guardianId      String?
  guardian        Guardian?       @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  contractId      String?
  contract        BillingContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  installmentNumber Int?
  description     String
  baseAmount      Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  fineAmount      Decimal         @default(0) @db.Decimal(12, 2)
  interestAmount  Decimal         @default(0) @db.Decimal(12, 2)
  amount          Decimal         @db.Decimal(12, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(12, 2)
  dueDate         DateTime
  paidAt          DateTime?
  status          ChargeStatus    @default(PENDING)
  provider        PaymentProvider @default(MANUAL)
  paymentMethod   PaymentMethod?
  externalId      String?
  externalStatus  String?
  invoiceUrl      String?
  bankSlipUrl     String?
  pixCopyPaste    String?
  pixQrCodeBase64 String?
  payments        Payment[]
  schoolDocuments SchoolDocument[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([contractId, installmentNumber])
  @@unique([provider, externalId])
  @@index([schoolId, status, dueDate])
  @@index([studentId, dueDate])
  @@index([guardianId, status])
  @@index([enrollmentId])
}

model Payment {
  id               String          @id @default(cuid())
  chargeId         String
  charge           Charge          @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amount           Decimal         @db.Decimal(12, 2)
  method           PaymentMethod
  provider         PaymentProvider @default(MANUAL)
  status           PaymentStatus   @default(RECEIVED)
  externalId       String?
  paidAt           DateTime        @default(now())
  recordedByUserId String?
  recordedBy       User?           @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime        @default(now())

  @@unique([provider, externalId])
  @@index([chargeId, paidAt])
  @@index([recordedByUserId])
}

model PaymentWebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType, createdAt])
}
