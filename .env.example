# Banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minha_escola?schema=public"

# Aplicação / autenticação
APP_URL="http://localhost:3000"
AUTH_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
PLATFORM_AUTH_SECRET="gere-outra-chave-aleatoria-com-32-ou-mais-caracteres"
SECURITY_PEPPER="gere-um-segredo-separado-para-hash-de-rate-limit"
CRON_SECRET="gere-um-token-longo-para-jobs"
MFA_ENCRYPTION_KEY="gere-uma-chave-separada-de-32-ou-mais-caracteres"
MFA_CHALLENGE_SECRET="gere-outro-segredo-separado-de-32-ou-mais-caracteres"
INTEGRATION_ENCRYPTION_KEY="gere-uma-chave-para-criptografar-chaves-de-integracao"
POSTGRES_PASSWORD="postgres"

# Seed
SEED_ADMIN_EMAIL="admin@minhaescola.local"
SEED_ADMIN_PASSWORD="troque-esta-senha-antes-de-usar"
SEED_SCHOOL_NAME="Colégio Demonstração"
SEED_PLATFORM_ADMIN_EMAIL="platform@minhaescola.local"
SEED_PLATFORM_ADMIN_PASSWORD="troque-esta-senha-forte"

# Financeiro opcional de cada escola
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Cobrança do próprio SaaS (conta separada)
PLATFORM_ASAAS_ENVIRONMENT="sandbox"
PLATFORM_ASAAS_API_KEY=""
PLATFORM_ASAAS_WEBHOOK_TOKEN=""
PLATFORM_BILLING_GRACE_DAYS="7"

# E-mail transacional / comunicação
RESEND_API_KEY=""
EMAIL_FROM="Minha Escola <nao-responda@seudominio.com>"

# WhatsApp Meta Cloud API
# Use a versão Graph API aprovada para seu app no momento do deploy.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"

# Storage privado S3-compatible (AWS S3, Cloudflare R2, MinIO etc.)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"

# Scanner de malware para uploads
# Em produção o scan é obrigatório por padrão; defina false apenas por decisão explícita.
REQUIRE_MALWARE_SCAN="true"
MALWARE_SCAN_PROVIDER="external"
MALWARE_SCAN_WEBHOOK_URL=""
MALWARE_SCAN_CALLBACK_TOKEN=""

# Backup local/manual
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"

# Observabilidade opcional
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.05"

# Versão exibida nos endpoints de health
APP_VERSION="1.0.0"
