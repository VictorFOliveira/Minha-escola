{
  email {$ACME_EMAIL}
  admin off
}

{$APP_DOMAIN} {
  encode zstd gzip

  reverse_proxy web:3000 {
    health_uri /api/health/ready
    health_interval 30s
    health_timeout 5s

    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
    header_up X-Real-IP {remote_host}
  }

  header {
    -Server
  }

  log {
    output stdout
    format json
  }
}
